{
  "name": "hoversource-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-invasive UI-to-Code inspector. Hover any element, press Alt+C, paste to your AI agent, and save 98.6% tokens for UI tasks in your giant codebase.",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=@hoversource/overlay-core",
    "clean": "tsc -b --clean",
    "test": "vitest run --exclude **/dist/**",
    "test:coverage": "vitest run --coverage.enabled=true --coverage.reporter=lcov --exclude **/dist/**"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@vitest/coverage-v8": "^4.1.9",
    "typescript": "^5.3.3"
  }
}
