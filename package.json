{
  "name": "hoversource-monorepo",
  "version": "1.0.0",
  "private": true,
  "description": "Zero-invasive UI-to-Code mapping tool for AI-assisted workflows",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run build --workspace=@hoversource/overlay-core",
    "clean": "tsc -b --clean"
  },
  "devDependencies": {
    "typescript": "^5.3.3",
    "@types/node": "^20.11.0"
  }
}
