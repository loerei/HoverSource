{
  "name": "@hoversource/companion-server",
  "version": "1.1.0",
  "type": "module",
  "main": "./dist/server.js",
  "types": "./dist/server.d.ts",
  "exports": {
    ".": {
      "types": "./dist/server.d.ts",
      "import": "./dist/server.js"
    },
    "./config": {
      "types": "./dist/configStore.d.ts",
      "import": "./dist/configStore.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "!dist/**/__tests__",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -b",
    "clean": "tsc -b --clean",
    "test": "vitest run"
  },
  "dependencies": {
    "@hoversource/client-injector": "workspace:*"
  },
  "devDependencies": {
    "vitest": "^4.1.8"
  }
}
